menu "DecaWave"

menuconfig DW1000
        bool "Support for DW1000"
	default n

if DW1000

config DW1000_STATE
        bool "Read the radio configuration back off the chip"
	default n
	help
	  Adds dw1000_get_radio_state() and its formatter, for comparing
	  what a chip actually holds against what it was asked for --
	  between two nodes, or across a driver change. Diagnostic: no
	  operational code needs it, and it is the only part of this
	  driver that formats strings, so it is off by default.

config DW1000_PROPRIETARY_PREAMBLE_LENGTH
        bool "Add support for proprietary preamble length"
	default y

config DW1000_PROPRIETARY_SFD
        bool "Add support for proprietary SFD"
	default y

config DW1000_PROPRIETARY_LONG_FRAME
        bool "Add support for proprietary long frame"
	default n

config DW1000_SFD_TIMEOUT
        bool "Add support for user defined SFD timeout"
	default n

config DW1000_SFD_TIMEOUT_DEFAULT
        int "Use specified SFD timeout, or computed one if set to 0"
	help
	  Value can be between 1 and 65535, but useful values
          are usually between 120 and 4161. Use computed value if set to 0.
	default 0

config DW1000_EVENT_COUNTERS
        bool "The chip's diagnostic event counters"
	default n
	help
	  Adds the event counter bank at register 0x2F: PHY header and
	  Reed-Solomon errors, good and bad CRCs, filtered frames,
	  overruns, the three timeouts, frames sent and the two warnings.
	  Diagnostic. The chip counts nothing until asked, and once
	  asked cannot be told to stop, only to start over.

config DW1000_ACCUMULATOR
        bool "Read the accumulator (channel impulse response)"
	default n
	help
	  Adds dw1000_rx_read_accumulator(), a window onto the CIR the
	  leading edge estimate was made from. What tells a first path
	  from a reflection, and so the diagnostic that speaks to ranging
	  accuracy rather than to link health. The buffer is the
	  caller's: the whole accumulator is 4064 octets.

config DW1000_TEMP_COMPENSATION
        bool "Correct transmit power and bandwidth for die temperature"
	default n
	help
	  Adds the corrections for the drift of transmit power and
	  channel bandwidth with die temperature. Both need a reference
	  captured when the board was calibrated. The power half is
	  arithmetic and safe at any time; the bandwidth half drives a
	  calibration on the chip and needs an idle transceiver.

endif

# Two symbols, because the probe has two layers with different dependencies
# and the Kconfig should not pretend otherwise in either direction.
#
# DW1000_PROBE is the record, the role names, the settle rule and the host
# ports. It is free of
# <dw1000/dw1000.h> by design -- that is what lets the line format be proved
# with no chip and no driver (tests/tests-probe.sh) -- so it is NOT under
# `if DW1000`, and nesting it there would invent a dependency the code does
# not have.
#
# DW1000_PROBE_EXCHANGE is the ranging exchange and the roles a node runs
# alone (tx, rx, temperature), which drive the chip and therefore do
# depend on the driver. When it was first written it lived
# in an application; moving it into the library is what created this
# second layer, and the earlier single-symbol comment here became stale at
# that moment. An implementer caught it.
menuconfig DW1000_PROBE
        bool "Support for the DW1000 probe (measurement instrument)"
	default n
	help
	  The measurement-only instrument's chip-free layer: the record, the
	  role names, the settle rule, and the host glue. Not the production stack, and not a driver
	  for anything -- see probe/include/dw1000/probe/record.h.

if DW1000_PROBE

config DW1000_PROBE_EXCHANGE
        bool "The probe's roles: the ranging exchange, tx, rx, temperature"
	depends on DW1000
	default y if DW1000
	help
	  The single- and double-sided two-way ranging exchange, and the
	  roles a node runs alone (transmit only, receive only, idle
	  temperature sampling), all of which drive the chip through the
	  driver. Off, the probe can still format and emit records; on, it
	  can produce them.

endif

endmenu